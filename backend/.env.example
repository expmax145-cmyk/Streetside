NODE_ENV=development
PORT=5001
# Postgres connection string. For Supabase use the *pooler* URL (Project Settings > Database > Connection pooling).
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

JWT_ACCESS_SECRET=change_me_access_secret_32chars_min
JWT_REFRESH_SECRET=change_me_refresh_secret_32chars_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173
BCRYPT_SALT_ROUNDS=10

# Number of reverse-proxy hops in front of this server (0 for direct)
TRUST_PROXY=0

# IANA timezone for open-now and offer-expiry. Default: Asia/Kolkata
APP_TIMEZONE=Asia/Kolkata

# Optional rate-limit overrides (requests per window)
API_RATE_LIMIT=300
WRITE_RATE_LIMIT=30

# SMTP config for email verification and password reset.
# Optional — if SMTP_HOST is left blank, emails are logged to the
# console instead of sent (see backend/src/utils/mailer.ts). Fill these
# in with a real provider (SendGrid, Mailgun, SES, etc.) to send mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="StreetSide <no-reply@streetside.app>"

# base URL of the deployed frontend, used to build the
# verification/reset links embedded in emails. Falls back to CLIENT_URL
# if unset.
FRONTEND_URL=http://localhost:5173
