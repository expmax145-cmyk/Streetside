# Google Maps JavaScript API key
# Create a restricted key at https://console.cloud.google.com/google/maps-apis
VITE_GOOGLE_MAPS_API_KEY=replace-with-your-google-maps-api-key
VITE_API_URL=http://localhost:5001/api
# Optional — must match the backend's APP_TIMEZONE for open-now display
# to agree between frontend and backend. Defaults to Asia/Kolkata.
VITE_APP_TIMEZONE=Asia/Kolkata
